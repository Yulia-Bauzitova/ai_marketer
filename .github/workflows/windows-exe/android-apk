name: Windows EXE

on:
  push:
  workflow_dispatch:

jobs:
  build:name: Android APK

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: "8.5"

      - name: Build debug APK
        run: gradle -p android assembleDebug --no-daemon

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: AI-Marketer-Android
          path: android/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error

    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install PyInstaller
        run: python -m pip install --upgrade pip pyinstaller

      - name: Build single file
        run: python -m PyInstaller --noconfirm --onefile --name AI_Marketer ai_marketer_one.py

      - name: Upload EXE
        uses: actions/upload-artifact@v4
        with:
          name: AI-Marketer-Windows
          path: dist/AI_Marketer.exe
          if-no-files-found: error
